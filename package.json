{
  "name": "satyalens",
  "version": "1.0.0",
  "description": "Multi-Layered AI Forensic Tool",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently \"cross-env BROWSER=none npm run start-react\" \"wait-on http://localhost:3000 && electron .\"",
    "start-react": "cd frontend && npm run dev",
    "install-all": "npm install && cd frontend && npm install",
    "build-python": "pyinstaller --onefile --name satya_engine backend/main.py",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^40.0.0",
    "electron-builder": "^26.5.0",
    "wait-on": "^7.2.0"
  }
}
